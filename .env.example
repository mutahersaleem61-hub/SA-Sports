# Copy this file to .env.local and fill in the values (see README.md).
# These two are PUBLIC by design. Security comes from Row Level Security in Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# OPTIONAL: free email notifications through Resend (server-side only, never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=SA SPORTS <onboarding@resend.dev>

# Shown on the website
NEXT_PUBLIC_SITE_NAME=SA SPORTS
